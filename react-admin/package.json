    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "oxc-transform-react": "^0.145.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
